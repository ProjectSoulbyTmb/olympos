# eidovara.org git server secrets - NEVER commit the real .env
# Used by: docker-compose.yml, backup.sh, bootstrap.sh

# --- Forgejo / Caddy ---
GIT_DOMAIN=git.eidovara.org
ACME_EMAIL=you@example.com

# Generated once by bootstrap.sh (openssl rand -hex 32) if absent
FORGEJO_LFS_JWT_SECRET=
FORGEJO_SECRET_KEY=
FORGEJO_OAUTH2_JWT_SECRET=

# --- Hetzner Object Storage (S3-compatible) ---
S3_ENDPOINT=https://ash.your-objectstorage.com
S3_BUCKET_BACKUPS=eidovara-backups
S3_BUCKET_DATASETS=eidovara-datasets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# restic repo encryption password - generated once, store a copy offline
RESTIC_PASSWORD=
